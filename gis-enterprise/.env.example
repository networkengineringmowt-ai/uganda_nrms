# Copy to .env and set strong passwords. NEVER commit .env.
PG_ADMIN_PASSWORD=CHANGE_ME_admin
PG_EDITOR_PASSWORD=CHANGE_ME_editor
PG_VIEWER_PASSWORD=CHANGE_ME_viewer
SVC_WEB_PASSWORD=CHANGE_ME_service
GEOSERVER_PASSWORD=CHANGE_ME_geoserver
PGADMIN_PASSWORD=CHANGE_ME_pgadmin
# Connection used by etl/, tools/gisctl.py, and scripts/backup.ps1 to reach
# the docker-compose `postgis` service (docker-compose.yml maps its 5432 to
# host port 5434 - 5432 is reserved for a native/non-docker Postgres install,
# see the port comment in docker-compose.yml and connectors/qgis_connection.md,
# which both use 5434). If you're running Postgres natively instead of via
# `docker compose up -d`, change PGPORT back to 5432.
PGHOST=localhost
PGPORT=5434
PGDATABASE=ugroads
PGUSER=gis_admin
# Every script that reads this file (etl/*.py, tools/gisctl.py,
# scripts/backup.ps1) parses it with a plain KEY=VALUE line split - none of
# them expand ${...} references the way a shell or docker-compose's own .env
# loader would. Set this to the SAME literal value as PG_ADMIN_PASSWORD above,
# not a ${PG_ADMIN_PASSWORD} reference - that string would be sent to
# Postgres as the literal password and every connection would fail auth.
PGPASSWORD=CHANGE_ME_admin
