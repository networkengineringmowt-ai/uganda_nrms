# Copy to .env and set strong values. NEVER commit .env.
# Used by both docker-compose.yml and docker-compose.source.yml.

# PostGIS database
POSTGRES_USER=geonode
POSTGRES_PASSWORD=CHANGE_ME_db
POSTGRES_DB=geonode

# GeoServer admin (docker-compose.yml only - docker-compose.source.yml takes
# GeoServer's own image defaults unless you add these here too)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=CHANGE_ME_geoserver

# Public hostname GeoServer advertises in capabilities documents / OWS URLs
SITE_HOST=localhost

# Django settings module for the custom uganda_roads app
DJANGO_SETTINGS_MODULE=uganda_roads.settings
